{
  "name": "quasar-intellisense",
  "displayName": "Quasar IntelliSense",
  "description": "IntelliSense for the Quasar Framework in Vue files: completions with color swatches for CSS classes and color props, icon previews, inline color and icon decorations, hovers, go to definition, and diagnostics with quick fixes. Understands your custom brand colors and installed icon sets.",
  "version": "0.4.0",
  "publisher": "antonisntoulis",
  "author": {
    "name": "Antonis Ntoulis"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/antonisntoulis/quasar-intellisense.git"
  },
  "bugs": {
    "url": "https://github.com/antonisntoulis/quasar-intellisense/issues"
  },
  "homepage": "https://github.com/antonisntoulis/quasar-intellisense#readme",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#050a14",
    "theme": "dark"
  },
  "pricing": "Free",
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Visualization",
    "Other"
  ],
  "keywords": [
    "quasar",
    "vue",
    "vuejs",
    "intellisense",
    "autocomplete",
    "css",
    "colors",
    "icons",
    "material icons"
  ],
  "extensionKind": [
    "workspace"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "configurationDefaults": {
      "[vue]": {
        "editor.quickSuggestions": {
          "other": "on",
          "comments": "off",
          "strings": "on"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package-build",
    "build": "node esbuild.mjs",
    "package-build": "npm run typecheck && node esbuild.mjs --production",
    "watch:esbuild": "node esbuild.mjs --watch",
    "watch:tsc": "tsc --noEmit --watch",
    "generate-data": "tsx scripts/generate-data.ts",
    "typecheck": "tsc --noEmit",
    "package": "vsce package --no-dependencies"
  },
  "dependencies": {
    "culori": "^4.0.1"
  },
  "devDependencies": {
    "@types/culori": "^2.1.1",
    "@types/node": "^24.0.0",
    "@types/vscode": "^1.125.0",
    "esbuild": "^0.28.1",
    "postcss": "^8.5.25",
    "postcss-scss": "^4.0.9",
    "postcss-selector-parser": "^7.1.0",
    "quasar": "^2.23.4",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
